# ─────────────────────────────────────────────────────────────────────────────
# Product Service — Java 17 / Spring Boot (port 8081)
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: product-service
  namespace: zylkerkart
  labels:
    app: product-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: product-service
  template:
    metadata:
      labels:
        app: product-service
        tier: backend
    spec:
      # ── Site24x7 Java APM agent (init container) ──
      volumes:
        - name: s247agent
          emptyDir: {}
      initContainers:
        - name: s247-java-agent
          image: site24x7/apminsight-javaagent:latest
          imagePullPolicy: IfNotPresent
          command: ['sh', '-c', 'cp -r /opt/site24x7/. /home/apm && chmod -R 755 /home/apm']
          volumeMounts:
            - name: s247agent
              mountPath: /home/apm
      containers:
        - name: product-service
          image: zylkerkart/product-service:latest
          ports:
            - containerPort: 8081
          volumeMounts:
            - name: s247agent
              mountPath: /home/apm
          env:
            - name: JAVA_TOOL_OPTIONS
              value: "-javaagent:/home/apm/apminsight-javaagent.jar -Dapminsight.application.name=ZylkerKart-ProductService"
            - name: S247_LICENSE_KEY
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: S247_LICENSE_KEY
            - name: SERVER_PORT
              value: "8081"
            - name: SPRING_DATASOURCE_URL
              value: "jdbc:mysql://mysql:3306/db_product?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
            - name: SPRING_DATASOURCE_USERNAME
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: DB_USER
            - name: SPRING_DATASOURCE_PASSWORD
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: MYSQL_ROOT_PASSWORD
            - name: SPRING_REDIS_HOST
              value: "redis"
            - name: SPRING_REDIS_PORT
              value: "6379"
          readinessProbe:
            httpGet:
              path: /health
              port: 8081
            initialDelaySeconds: 60
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8081
            initialDelaySeconds: 90
            periodSeconds: 20
          resources:
            requests:
              memory: "512Mi"
              cpu: "200m"
            limits:
              memory: "1Gi"
              cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: product-service
  namespace: zylkerkart
spec:
  selector:
    app: product-service
  ports:
    - port: 8081
      targetPort: 8081
---
# ─────────────────────────────────────────────────────────────────────────────
# Order Service — Node.js 18 / Express (port 8082)
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-service
  namespace: zylkerkart
  labels:
    app: order-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: order-service
  template:
    metadata:
      labels:
        app: order-service
        tier: backend
    spec:
      # ── Site24x7 Node.js APM agent (init container, prebuilt image) ──
      volumes:
        - name: s247agent
          emptyDir: {}
      initContainers:
        - name: s247-nodejs-agent
          image: site24x7/apminsight-nodejsagent:latest
          imagePullPolicy: IfNotPresent
          command: ['sh', '-c', 'cp -r /opt/site24x7/. /apm && chmod -R 755 /apm']
          volumeMounts:
            - name: s247agent
              mountPath: /apm
      containers:
        - name: order-service
          image: zylkerkart/order-service:latest
          ports:
            - containerPort: 8082
          volumeMounts:
            - name: s247agent
              mountPath: /apm
          env:
            - name: NODE_OPTIONS
              value: "--require /apm/node_modules/apminsight"
            - name: APMINSIGHT_LICENSE_KEY
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: S247_LICENSE_KEY
            - name: APMINSIGHT_APP_NAME
              value: "ZylkerKart-OrderService"
            - name: APMINSIGHT_APP_PORT
              value: "8082"
            - name: PORT
              value: "8082"
            - name: DB_HOST
              value: "mysql"
            - name: DB_PORT
              value: "3306"
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: DB_USER
            - name: DB_PASSWORD
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: MYSQL_ROOT_PASSWORD
            - name: DB_NAME
              value: "db_order"
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            - name: PAYMENT_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: PAYMENT_SERVICE_URL
            - name: AUTH_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: AUTH_SERVICE_URL
          readinessProbe:
            httpGet:
              path: /health
              port: 8082
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8082
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              memory: "192Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "300m"
---
apiVersion: v1
kind: Service
metadata:
  name: order-service
  namespace: zylkerkart
spec:
  selector:
    app: order-service
  ports:
    - port: 8082
      targetPort: 8082
---
# ─────────────────────────────────────────────────────────────────────────────
# Search Service — Go 1.21 / Gin (port 8083)
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: search-service
  namespace: zylkerkart
  labels:
    app: search-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: search-service
  template:
    metadata:
      labels:
        app: search-service
        tier: backend
    spec:
      # ── Init container: copy Go binary to hostPath for eBPF uprobe access ──
      initContainers:
        - name: copy-binary
          image: zylkerkart/search-service:latest
          command: ["cp", "/app/search-service", "/apm-bin/search-service"]
          volumeMounts:
            - name: apm-binaries
              mountPath: /apm-bin
      containers:
        - name: search-service
          image: zylkerkart/search-service:latest
          # Run binary from hostPath so eBPF uprobes can attach
          command: ["/apm-bin/search-service"]
          ports:
            - containerPort: 8083
          env:
            - name: PORT
              value: "8083"
            - name: DB_HOST
              value: "mysql"
            - name: DB_PORT
              value: "3306"
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: DB_USER
            - name: DB_PASSWORD
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: MYSQL_ROOT_PASSWORD
            - name: DB_NAME
              value: "db_search"
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
          readinessProbe:
            httpGet:
              path: /health
              port: 8083
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8083
            initialDelaySeconds: 15
            periodSeconds: 20
          volumeMounts:
            - name: apm-binaries
              mountPath: /apm-bin
          resources:
            requests:
              memory: "96Mi"
              cpu: "50m"
            limits:
              memory: "320Mi"
              cpu: "200m"
      volumes:
        - name: apm-binaries
          hostPath:
            path: /var/lib/apm-binaries
            type: DirectoryOrCreate
---
apiVersion: v1
kind: Service
metadata:
  name: search-service
  namespace: zylkerkart
spec:
  selector:
    app: search-service
  ports:
    - port: 8083
      targetPort: 8083
---
# ─────────────────────────────────────────────────────────────────────────────
# Payment Service — Python 3.11 / FastAPI (port 8084)
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-service
  namespace: zylkerkart
  labels:
    app: payment-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: payment-service
  template:
    metadata:
      labels:
        app: payment-service
        tier: backend
    spec:
      # ── Site24x7 Python APM agent (init container) ──
      volumes:
        - name: s247agent
          emptyDir: {}
      initContainers:
        - name: s247-python-agent
          image: site24x7/apminsight-pythonagent:latest
          command: ['sh', '-c', 'cp -r /opt/site24x7/. /home/apm && chmod -R 755 /home/apm']
          volumeMounts:
            - name: s247agent
              mountPath: /home/apm
      containers:
        - name: payment-service
          image: zylkerkart/payment-service:latest
          command: ["/bin/sh", "-c", "/home/apm/agent_start.sh"]
          ports:
            - containerPort: 8084
          volumeMounts:
            - name: s247agent
              mountPath: /home/apm
          env:
            - name: APP_RUN_COMMAND
              value: "uvicorn app.main:app --host 0.0.0.0 --port 8084"
            - name: APM_APP_NAME
              value: "ZylkerKart-PaymentService"
            - name: S247_LICENSE_KEY
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: S247_LICENSE_KEY
            - name: PORT
              value: "8084"
            - name: DB_HOST
              value: "mysql"
            - name: DB_PORT
              value: "3306"
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: DB_USER
            - name: DB_PASSWORD
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: MYSQL_ROOT_PASSWORD
            - name: DB_NAME
              value: "db_payment"
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
          readinessProbe:
            httpGet:
              path: /health
              port: 8084
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8084
            initialDelaySeconds: 25
            periodSeconds: 20
          resources:
            requests:
              memory: "192Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "300m"
---
apiVersion: v1
kind: Service
metadata:
  name: payment-service
  namespace: zylkerkart
spec:
  selector:
    app: payment-service
  ports:
    - port: 8084
      targetPort: 8084
---
# ─────────────────────────────────────────────────────────────────────────────
# Auth Service — C# / .NET 8 (port 8085)
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: auth-service
  namespace: zylkerkart
  labels:
    app: auth-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: auth-service
  template:
    metadata:
      labels:
        app: auth-service
        tier: backend
    spec:
      # ── Site24x7 .NET APM agent (init container) ──
      volumes:
        - name: s247dotnetagent
          emptyDir: {}
      initContainers:
        - name: s247-dotnet-agent
          image: site24x7/apminsight-dotnetagent:latest
          imagePullPolicy: IfNotPresent
          command: ['sh', '-c', 'cp -r /opt/site24x7/APMDotNetAgent/. /home/APMDotNetAgent/ && chmod -R 755 /home/APMDotNetAgent']
          volumeMounts:
            - name: s247dotnetagent
              mountPath: /home/APMDotNetAgent
      containers:
        - name: auth-service
          image: zylkerkart/auth-service:latest
          ports:
            - containerPort: 8085
          volumeMounts:
            - name: s247dotnetagent
              mountPath: /home/APMDotNetAgent
          env:
            - name: S247_LICENSE_KEY
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: S247_LICENSE_KEY
            - name: CORECLR_ENABLE_PROFILING
              value: "1"
            - name: CORECLR_PROFILER
              value: "{9D363A5F-ED5F-4AAC-B456-75AFFA6AA0C8}"
            - name: DOTNETCOREAGENT_HOME
              value: "/home/APMDotNetAgent"
            - name: CORECLR_PROFILER_PATH_64
              value: "/home/APMDotNetAgent/x64/libClrProfilerAgent.so"
            - name: CORECLR_PROFILER_PATH_32
              value: "/home/APMDotNetAgent/x86/libClrProfilerAgent.so"
            - name: DOTNET_STARTUP_HOOKS
              value: "/home/APMDotNetAgent/netstandard2.0/DotNetAgent.Loader.dll"
            - name: MANAGEENGINE_COMMUNICATION_MODE
              value: "direct"
            - name: SITE24X7_APP_NAME
              value: "ZylkerKart-AuthService"
            - name: PORT
              value: "8085"
            - name: DB_HOST
              value: "mysql"
            - name: DB_PORT
              value: "3306"
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: DB_USER
            - name: DB_PASSWORD
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: MYSQL_ROOT_PASSWORD
            - name: DB_NAME
              value: "db_auth"
            - name: JWT_SECRET
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: JWT_SECRET
            - name: JWT_EXPIRY_MINUTES
              value: "15"
            - name: JWT_REFRESH_EXPIRY_DAYS
              value: "7"
          readinessProbe:
            httpGet:
              path: /health
              port: 8085
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8085
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              memory: "192Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "300m"
---
apiVersion: v1
kind: Service
metadata:
  name: auth-service
  namespace: zylkerkart
spec:
  selector:
    app: auth-service
  ports:
    - port: 8085
      targetPort: 8085
---
# ─────────────────────────────────────────────────────────────────────────────
# Storefront BFF — Java 17 / Spring Boot 3.2 (port 80)
# With Site24x7 APM Insight Java agent via InitContainers
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: storefront
  namespace: zylkerkart
  labels:
    app: storefront
    tier: frontend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: storefront
  template:
    metadata:
      labels:
        app: storefront
        tier: frontend
    spec:
      # ── Shared volume for APM agent binaries ──
      volumes:
        - name: s247agent
          emptyDir: {}

      # ── Init Container: download & extract Java APM agent ──
      initContainers:
        - name: s247-java-agent
          image: site24x7/apminsight-javaagent:latest
          imagePullPolicy: IfNotPresent
          command: ['sh', '-c', 'cp -r /opt/site24x7/. /home/apm && chmod -R 755 /home/apm']
          volumeMounts:
            - name: s247agent
              mountPath: /home/apm

      containers:
        - name: storefront
          image: zylkerkart/storefront:latest
          ports:
            - containerPort: 80

          volumeMounts:
            - name: s247agent
              mountPath: /home/apm

          env:
            # ── Site24x7 Java APM Config ──
            - name: JAVA_TOOL_OPTIONS
              value: "-javaagent:/home/apm/apminsight-javaagent.jar -Dapminsight.application.name=ZylkerKart-Storefront"
            - name: S247_LICENSE_KEY
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: S247_LICENSE_KEY
            # ── Redis Config ──
            - name: REDIS_HOST
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: REDIS_HOST
            - name: REDIS_PORT
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: REDIS_PORT
            # ── Service URLs ──
            - name: PRODUCT_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: PRODUCT_SERVICE_URL
            - name: ORDER_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: ORDER_SERVICE_URL
            - name: SEARCH_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: SEARCH_SERVICE_URL
            - name: PAYMENT_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: PAYMENT_SERVICE_URL
            - name: AUTH_SERVICE_URL
              valueFrom:
                configMapKeyRef:
                  name: zylkerkart-config
                  key: AUTH_SERVICE_URL

          startupProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 15
            periodSeconds: 5
            failureThreshold: 12
          readinessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 20
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "400m"
---
apiVersion: v1
kind: Service
metadata:
  name: storefront
  namespace: zylkerkart
spec:
  selector:
    app: storefront
  ports:
    - port: 80
      targetPort: 80

